# ─── Amazon Associates ────────────────────────────────────────────────────────
# Your affiliate tag, e.g. mysite-20
AMAZON_AFFILIATE_TAG=your-tag-20

# ─── Ayrshare ─────────────────────────────────────────────────────────────────
# API key from https://app.ayrshare.com/dashboard/settings/api-key
AYRSHARE_API_KEY=your_ayrshare_api_key

# ─── Scraping settings ────────────────────────────────────────────────────────
# Minimum product price to include (USD)
MIN_PRICE=50.0

# Maximum number of products to collect across all categories
MAX_PRODUCTS=10

# Output file path for scraped product data
OUTPUT_FILE=products.json
